# Template for local environment variables.
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env is git-ignored and must NEVER be committed.
# This file contains placeholders only - no real secrets.

# --- Required ---
# Your Anthropic (Claude) API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_api_key_here

# --- Optional (sensible defaults are applied if omitted) ---
# Claude model used to generate the LinkedIn posts
ANTHROPIC_MODEL=claude-opus-5

# Reasoning effort / token spend: low | medium | high | xhigh | max
# Claude Opus 5 uses effort instead of temperature.
ANTHROPIC_EFFORT=high
